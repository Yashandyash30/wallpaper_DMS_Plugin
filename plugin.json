{
    "$schema": "https://duxlabs.dev/schemas/plugin.json",
    "id": "wallpaperSpan",
    "name": "Wallpaper Span",
    "description": "Multi-monitor image and live mpvpaper wallpaper browser with Spanright alignment, spanning, same-on-all, and per-display modes",
    "version": "1.0.0",
    "author": "Yashandyash30",
    "icon": "panorama",
    "type": "composite",
    "capabilities": [
        "wallpaper",
        "daemon",
        "dankbar-widget",
        "control-center"
    ],
    "components": {
        "widget": "./WallpaperSpanWidget.qml",
        "daemon": "./WallpaperSpanDaemon.qml"
    },
    "settings": "./WallpaperSpanSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "requires_dms": ">=2.0.0",
    "dependencies": [
        "imagemagick",
        "mpvpaper",
        "ffmpeg"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
